<!-- portenvd as the app's login item (SMAppService.agent, 1.1). launchd
     starts it at login and again whenever it exits (a crash, an update
     relaunch); the app never starts it. -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.portenv.portenvd</string>
	<key>BundleProgram</key>
	<string>Contents/Helpers/portenvd</string>
	<key>AssociatedBundleIdentifiers</key>
	<array>
		<string>com.portenv.Portenv</string>
	</array>
	<key>KeepAlive</key>
	<true/>
	<key>RunAtLoad</key>
	<true/>
	<key>ProcessType</key>
	<string>Interactive</string>
	<key>EnvironmentVariables</key>
	<dict>
		<key>PORTENVD_LOG</key>
		<string>file</string>
	</dict>
</dict>
</plist>
