# Build output
/bin/
# Stray binaries from "go build" run inside core/ (make build writes to bin/)
/core/portenv
/core/portenvd
/core/portenv-runner
/core/portenv-agent
.build/
.swiftpm/
*.xcodeproj/xcuserdata/
DerivedData/

# Editors and OS
.DS_Store
.idea/
.vscode/
*.swp

# Never commit secrets or local configuration
.env
.env.*
*.pem
*.key
restic-password*

# Go workspace checksums: never committed, so a release needs no special checkout (R-0096)
go.work.sum
